# Backend
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:4000
DATABASE_URL=./prsignal.db
# In production this MUST be a strong, non-default value of >=32 chars.
JWT_SECRET=YOUR_JWT_SECRET
# Bearer token guarding the /admin endpoints. Required in production (>=16 chars).
ADMIN_API_TOKEN=YOUR_ADMIN_API_TOKEN
# Comma-separated browser origin allowlist for CORS. Empty = permissive (POC only).
CORS_ORIGINS=
# Extension JWT lifetime in days.
EXTENSION_TOKEN_TTL_DAYS=30
# Max accepted request body size in bytes.
MAX_BODY_BYTES=1000000

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET
# Optional fine-grained token with read access to pull requests in watched repositories.
GITHUB_TOKEN=

# Slack App
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET

# Product behavior
DEFAULT_SNOOZE_MINUTES=30
OVERLAY_POLL_SECONDS=30
ESCALATION_MINUTES=120
# Escalations only. Repository feeds and daily digests use their own channels.
TEAM_CHANNEL_ID=YOUR_TEAM_CHANNEL_ID

# Optional repository reconciliation worker (minimum interval: 60 seconds)
PR_SYNC_ENABLED=false
PR_SYNC_INTERVAL_SECONDS=300

# Daily open-PR Slack digest (disabled until explicitly enabled)
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_CHANNEL_ID=YOUR_DAILY_DIGEST_CHANNEL_ID
DAILY_DIGEST_REVIEWER_GITHUB=SUDARSHANCHAUDHARI
DAILY_DIGEST_REPOSITORIES=SUDARSHANCHAUDHARI/PRSignal,SUDARSHANCHAUDHARI/ChangeGuardAI
DAILY_DIGEST_TIME=09:00
DAILY_DIGEST_TIMEZONE=Asia/Bangkok
DAILY_DIGEST_WORKER_SECONDS=60

# Reminder worker
REMINDER_AFTER_MINUTES=60
REMINDER_WORKER_SECONDS=300
