{
  "name": "prsignal-hybrid-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid PR review enforcement MVP: GitHub webhook + Slack app + Chrome extension overlay.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @prsignal/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @prsignal/api test",
    "test:webhook": "pnpm --filter @prsignal/api test:webhook"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "axios": "^1.21.1",
      "follow-redirects": "^1.16.3",
      "form-data": "^4.0.6",
      "proxy-addr": "^2.0.8",
      "body-parser@1": "^1.20.9",
      "qs": "^6.17.1",
      "brace-expansion@1": "^5.0.0",
      "brace-expansion@5": "^5.0.13",
      "js-yaml@4": "^4.3.2"
    }
  }
}
