{
  "name": "prsignal-hybrid-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid PR review enforcement MVP: GitHub webhook + Slack app + Chrome extension overlay.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @prsignal/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @prsignal/api test",
    "test:webhook": "pnpm --filter @prsignal/api test:webhook"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "license": "MIT"
}
