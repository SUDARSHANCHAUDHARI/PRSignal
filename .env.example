# Backend
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:4000
DATABASE_URL=./prsignal.db
# In production this MUST be a strong, non-default value of >=32 chars.
JWT_SECRET=YOUR_JWT_SECRET
# Bearer token guarding the /admin endpoints. Required in production (>=16 chars).
ADMIN_API_TOKEN=YOUR_ADMIN_API_TOKEN
# Comma-separated browser origin allowlist for CORS. Empty = permissive (POC only).
CORS_ORIGINS=
# Extension JWT lifetime in days.
EXTENSION_TOKEN_TTL_DAYS=30
# Max accepted request body size in bytes.
MAX_BODY_BYTES=1000000

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET

# Slack App
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET

# Product behavior
DEFAULT_SNOOZE_MINUTES=30
OVERLAY_POLL_SECONDS=30
ESCALATION_MINUTES=120
TEAM_CHANNEL_ID=YOUR_TEAM_CHANNEL_ID

# Reminder worker
REMINDER_AFTER_MINUTES=60
REMINDER_WORKER_SECONDS=300
